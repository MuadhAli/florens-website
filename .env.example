# Public site URL for SEO (canonical, sitemap, Open Graph)
VITE_SITE_URL=https://florensservices.com

# API key for the site chat assistant
# - Groq keys (from console.groq.com) start with gsk_
# - xAI Grok keys (from console.x.ai) use a different format
GROK_API_KEY=your_api_key_here

# Optional: port for production server (default 3001)
PORT=3001
